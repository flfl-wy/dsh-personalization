{
    "name": "dsh-personalization",
    "version": "0.1.0",
    "private": true,
    "description": "个性化设置页：在 DSH Settings 中编辑全局 AGENTS.md",
    "type": "module",
    "main": "lib/index.js",
    "exports": {
        ".": "./lib/index.js",
        "./client": "./lib/client.js",
        "./package.json": "./package.json"
    },
    "scripts": {
        "test": "node --test test/agents-file.test.mjs test/client-bundle.test.mjs test/client-render.test.mjs test/manifest-parity.test.mjs",
        "preview": "node tools/visual-preview.mjs --shoot"
    },
    "dsh": {
        "client": {
            "platform": "web",
            "inject": [
                "@deepseek-ai/dsh-client-locale",
                "@deepseek-ai/dsh-api-gateway",
                "@deepseek-ai/dsh-client-ui-settings"
            ]
        },
        "bundle": {
            "patch": "./cordis.patch.yml"
        }
    },
    "dependencies": {
        "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.8",
        "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2",
        "zod": "^4.4.3"
    },
    "peerDependencies": {
        "@deepseek-ai/dsh": ">=0.1.5-rc.0 <0.3.0-0",
        "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.0 <0.3.0-0"
    },
    "peerDependenciesMeta": {
        "@deepseek-ai/dsh": {
            "optional": true
        },
        "@deepseek-ai/dsh-typert-protocol": {
            "optional": true
        }
    },
    "files": [
        "lib",
        "cordis.patch.yml",
        "README.md"
    ]
}
