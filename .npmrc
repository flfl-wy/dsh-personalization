# This plugin is installed into a DSH profile as a *linked* root (a symlink in
# <profile>/node_modules). DSH's runtime resolution routes the packages listed
# in peerDependencies to the copies the running Harness installation owns
# (see packages/boot/app-boot/src/profile-resolution/resolver.ts routeLinked);
# everything else resolves through this directory's own node_modules.
#
# So: peers must never be materialized here — a local @deepseek-ai/cordis would
# be a second cordis instance and break Service registration.
auto-install-peers=false
